  - m_Id: 2041606569993
    m_Localized: "DJ a hudobn\xFD producent"
    m_Metadata:
      m_Items: []
  - m_Id: 2041606569994
    m_Localized: "Spisovate\u013Eka bestsellerov"
    m_Metadata:
      m_Items: []
  - m_Id: 2041606569995
    m_Localized: "Futbalov\xE1 hviezda"
    m_Metadata:
      m_Items: []
  - m_Id: 2041606569996
    m_Localized: "Celebrity \u0161\xE9fkuch\xE1r"
    m_Metadata:
      m_Items: []
  - m_Id: 2041606569997
    m_Localized: "Filmov\xE1 here\u010Dka"
    m_Metadata:
      m_Items: []
  - m_Id: 2041606569998
    m_Localized: "Popov\xE1 hviezda"
    m_Metadata:
      m_Items: []
  - m_Id: 2041606569999
    m_Localized: "Nat\xE1\u010Da vide\xE1 z exotick\xFDch miest pre pol mili\xF3na sledovate\u013Eov. Sta\u010D\xED jej \xFAtuln\xFD hotel a pekn\xFD v\xFDh\u013Ead."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570000
    m_Localized: "Fot\xED z\xE1pady slnka a tropick\xFA pr\xEDrodu pre cestovn\xE9 magaz\xEDny. Po celodennom foten\xED si r\xE1d d\xE1 drink."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570001
    m_Localized: "Rann\xE9 cvi\u010Denie, zdrav\xE9 smoothie a stories pri baz\xE9ne. Bez baz\xE9na nepr\xEDde."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570002
    m_Localized: "Hodnot\xED re\u0161taur\xE1cie po celom svete. Jeho recenzia vie rezortu prinies\u0165 z\xE1stupy host\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570003
    m_Localized: "Hr\xE1 na najv\xE4\u010D\u0161\xEDch pl\xE1\u017Eov\xFDch p\xE1rty. Chce \u0161pi\u010Dkov\xFD bar a baz\xE9n na after party."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570004
    m_Localized: "Na ostrov prich\xE1dza dop\xEDsa\u0165 nov\xFA knihu. Potrebuje pokoj, wellness a pohodln\xFD hotel."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570005
    m_Localized: "Kapit\xE1n reprezent\xE1cie si u\u017E\xEDva dovolenku po sez\xF3ne. O\u010Dak\xE1va luxusn\xFD hotel a najlep\u0161\xED baz\xE9n."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570006
    m_Localized: "Majite\u013E ocenen\xFDch re\u0161taur\xE1ci\xED a hviezda kulin\xE1rskych show. Skontroluje ka\u017Ed\xFA kuchy\u0148u aj bar."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570007
    m_Localized: "Hviezda ve\u013Ek\xFDch filmov h\u013Ead\xE1 s\xFAkromie a relax. Prijme len luxusn\xFD hotel s najlep\u0161\xEDm wellness."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570008
    m_Localized: "Najzn\xE1mej\u0161ia spev\xE1\u010Dka sveta. Jej n\xE1v\u0161teva presl\xE1vi rezort - ale v\u0161etko mus\xED by\u0165 dokonal\xE9."
    m_Metadata:
      m_Items: []
  - m_Id: 2041606570009
    m_Localized: Jazyk
    m_Metadata:
      m_Items: []
